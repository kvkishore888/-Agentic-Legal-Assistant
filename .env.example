# Lightweight deployment defaults
EMBEDDING_MODEL=hash
EMBEDDING_DIMENSION=256
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_DB_PATH=.legal_chroma
VECTOR_COLLECTION=legal_chunks_v2

# Conversational LLM (optional; deterministic grounding fallback remains active)
LLM_PROVIDER=none
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_MAX_OUTPUT_TOKENS=700
